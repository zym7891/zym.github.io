        header {
            text-align: center;
            border-bottom: 1px solid #990000;
            padding-bottom: 25px;
            margin-bottom: 35px;
        }
        h1 {
            color: #bb0000;
            font-size: 42px;
            margin-bottom:8px;
        }
        .sub-title{
            color:#888;
            font-size:18px;
        }
        .section{
            background:#161616;
            padding:26px;
            border-radius:12px;
            margin-bottom:24px;
            border-left:4px solid #aa0000;
        }
        h2{
            color:#dd3333;
            margin-bottom:14px;
            font-size:24px;
        }
        ul{
            padding-left:22px;
        }
